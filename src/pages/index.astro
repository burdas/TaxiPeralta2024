---
import EnlacesSkeleton from "../components/EnlacesSkeleton.astro";
export const prerender = true;
import Contacto from '../components/Contacto.astro';
import Enlaces from '../components/Enlaces.astro';
import Footer from '../components/Footer.astro';
import Galeria from '../components/Galeria.astro';
import Hero from '../components/Hero.astro';
import Informacion from '../components/Informacion.astro';
import NavBar from '../components/NavBar.astro';
import Tarifas from '../components/Tarifas.astro';
import TarifasSkeleton from '../components/TarifasSkeleton.astro';
import CalculadoraTarifa from '../components/CalculadoraTarifa.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Taxi Peralta">
	<NavBar scrollLimit={200} disableTheme={false} />
	<Hero />
	<Informacion />
	<Tarifas server:defer>
		<TarifasSkeleton slot="fallback" />
	</Tarifas>
	<CalculadoraTarifa />
	<div class="max-w-[1200px] mx-auto px-container-padding mb-16">
		<div
			class="card-lift bg-tp-surface-container-high border border-tp-outline-variant/30 rounded-2xl p-8 md:p-10 flex flex-col md:flex-row items-center justify-between gap-8"
		>
			<div class="flex items-center gap-6 reveal reveal-left">
				<div
					class="w-16 h-16 rounded-full bg-tp-primary/10 flex items-center justify-center text-tp-primary shrink-0"
				>
					<span class="material-symbols-outlined text-4xl">calculate</span>
				</div>
				<div>
					<h3
						class="font-tp-display text-[20px] leading-7 font-semibold text-tp-on-surface"
					>
						¿Necesitas una ruta exacta?
					</h3>
					<p class="text-tp-on-surface-variant">
						Usa nuestra calculadora avanzada con mapas para obtener el precio
						real de puerta a puerta.
					</p>
				</div>
			</div>
			<a
				class="reveal reveal-right bg-tp-primary text-tp-on-primary px-8 py-4 rounded-full font-bold uppercase tracking-widest hover:brightness-110 transition-all primary-glow whitespace-nowrap"
				href="./calculadora_viajes"
			>
				Calculadora Avanzada
			</a>
		</div>
	</div>
	<Galeria />
	<Enlaces server:defer>
		<EnlacesSkeleton slot="fallback" />
	</Enlaces>
	<Contacto />
	<Footer transparent={false} />
</Layout>

<script>
	const initRevealObserver = () => {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-visible");
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.1 }
		);
		document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
		return observer;
	};

	let revealObserver = initRevealObserver();

	new MutationObserver((mutations) => {
		mutations.forEach((mutation) => {
			mutation.addedNodes.forEach((node) => {
				if (!(node instanceof HTMLElement)) return;
				node.querySelectorAll?.(".reveal").forEach((el) => {
					el.classList.contains("is-visible") ||
						revealObserver.observe(el);
				});
			});
		});
	}).observe(document.body, { childList: true, subtree: true });
</script>
