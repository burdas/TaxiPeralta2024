---
import Loader from "../../../components/Icons/Loader.astro";
export const prerender = false;
import Layout from "../../../layouts/Layout.astro";
import { verifySession } from '../../../auth/session';
import AdminLayout from "../../../components/AdminReact/AdminLayout";

const session = Astro.cookies.get('session')?.value;
if (!session || !verifySession(session)) {
    return Astro.redirect('/login');
}
---

<Layout title="Factura Educación - Admin">
    <AdminLayout activePath="/admin/facturacion/educacion" client:only="react">
        <div slot="fallback" class="w-full min-h-svh flex justify-center items-center">
            <Loader className="size-24 animate-spin" />
        </div>
    </AdminLayout>
</Layout>
