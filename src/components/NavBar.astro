---
import { routeList } from "../model/navbar.ts";
import ThemeButton from "./ThemeButton.astro";
import { Image } from "astro:assets";
import logoImage from "../assets/logo.jpg";
import DialogMenu from "./DialogMenu.astro";

const { disableTheme } = Astro.props;

---
<header
  class="sticky top-0 z-50 w-full bg-tp-background/90 backdrop-blur-md border-b border-tp-outline-variant transition-colors duration-300 ease-out"
>
  <nav
    class="flex justify-between items-center w-full px-container-padding py-3 max-w-[1200px] mx-auto"
  >
    <a class="flex items-center gap-2" href="./">
      <Image
        src={logoImage}
        alt="logo de taxi peralta"
        class="h-10 w-10 object-contain rounded-lg"
      />
      <p
        class="font-tp-display text-[20px] leading-7 font-bold text-tp-on-surface tracking-tight hidden sm:inline"
      >
        Taxi Peralta
      </p>
    </a>
    <div class="hidden lg:flex gap-8 items-center">
      {
        routeList.map(({ href, label }) => (
          <a
            href={href}
            class="text-[12px] leading-4 tracking-[0.05em] font-semibold text-tp-on-surface-variant hover:text-tp-primary transition-colors duration-200"
          >
            {label}
          </a>
        ))
      }
    </div>
    <div class="flex items-center gap-2">
      {!disableTheme && <ThemeButton />}
      <a
        href="./#Contacto"
        class="hidden sm:inline-flex bg-tp-primary text-tp-on-primary px-6 py-2 text-[12px] leading-4 tracking-wider rounded-full font-bold uppercase transition-all active:scale-95 primary-glow"
      >
        Contactar
      </a>
      <button
        class="lg:hidden hover:bg-tp-surface-container-high p-3 rounded-md transition-colors duration-300 ease-in-out text-tp-on-surface"
        id="dialogTrigger"
        aria-label="Abrir menú"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          fill="none"
          ><path
            fill="currentColor"
            fill-rule="evenodd"
            d="M1.5 3a.5.5 0 0 0 0 1h12a.5.5 0 0 0 0-1h-12ZM1 7.5a.5.5 0 0 1 .5-.5h12a.5.5 0 0 1 0 1h-12a.5.5 0 0 1-.5-.5Zm0 4a.5.5 0 0 1 .5-.5h12a.5.5 0 0 1 0 1h-12a.5.5 0 0 1-.5-.5Z"
            clip-rule="evenodd"></path></svg
        >
      </button>
    </div>
  </nav>
</header>
<DialogMenu disableTheme={disableTheme} />
<script>
  const dialogTrigger = document.getElementById("dialogTrigger");
  const dialog = document.getElementById("dialogMenu") as HTMLDialogElement;
  dialogTrigger!.addEventListener("click", () => {
    document.body.style.overflow = "hidden";
    dialog.showModal();
  });
</script>
