---
import { Image } from "astro:assets";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/galery/*.avif"
);
const importImages = Object.values(images);
const spans = (i: number): string => {
  if (i === 0) return "col-span-2 row-span-2";
  if (i % 3 === 0) return "col-span-2";
  return "";
};
---

<section
  id="Galeria"
  class="py-section-gap px-container-padding max-w-[1200px] mx-auto scroll-mt-24"
>
  <h2 class="font-tp-display text-[32px] leading-10 font-bold text-tp-on-surface text-center mb-12">
    Nuestro Taxi y Entorno
  </h2>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 auto-rows-[200px]">
    {
      importImages.map((e, i) =>
        e().then((val) => {
          return (
            <a
              class:list={[
                "reveal overflow-hidden rounded-xl imgLink cursor-zoom-in group block",
                spans(i),
              ]}
              style={`transition-delay: ${(i % 8) * 80}ms`}
              href={val.default.src}
              data-pswp-width={val.default.width}
              data-pswp-height={val.default.height}
              aria-label={`Imagen de la galeria ${i}`}
            >
              <Image
                src={val.default}
                alt={`Imagen de la galeria ${i}`}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 animate-pulse bg-tp-surface-container-high"
              />
            </a>
          );
        })
      )
    }
  </div>
</section>
<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  document
    .querySelectorAll(".animate-pulse")
    .forEach((e) => e.classList.remove("animate-pulse"));

  const lightbox = new PhotoSwipeLightbox({
    gallery: "#Galeria",
    children: "a.imgLink",
    pswpModule: () => import("photoswipe"),
  });
  lightbox.init();
</script>
