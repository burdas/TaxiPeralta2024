---
import { Image } from "astro:assets";
import logoImage from "../assets/logo.jpg";

const { transparent } = Astro.props;
---

{
  transparent ? (
    <footer class="w-full h-16 flex justify-center">
      <div class="container h-full flex flex-col sm:flex-row sm:justify-between items-center">
        <p class="text-sm text-pretty text-center text-tp-on-surface-variant">
          © 2024 Taxi Peralta. Todos los derechos reservados.
        </p>
        <p class="text-tp-on-surface-variant text-sm text-center">
          Developed by{" "}
          <a
            class="font-semibold text-tp-primary hover:border-b-2 border-b-tp-primary transition-all duration-100"
            href="https://burdas.github.io"
            target="_blank"
          >
            Burdas
          </a>
        </p>
      </div>
    </footer>
  ) : (
    <footer class="bg-tp-surface-container-lowest border-t border-tp-outline-variant">
      <div
        class="max-w-[1200px] mx-auto px-container-padding py-section-gap flex flex-col md:flex-row justify-between items-center gap-8"
      >
        <div class="text-center md:text-left">
          <div class="flex items-center justify-center md:justify-start gap-3 mb-4">
            <Image
              src={logoImage}
              alt="Taxi Peralta Logo"
              class="h-12 w-12 object-contain rounded-lg"
            />
            <p
              class="font-tp-display text-[20px] leading-7 font-bold text-tp-on-surface"
            >
              Taxi Peralta
            </p>
          </div>
        </div>
        <div class="flex gap-6">
          <a
            class="text-[12px] leading-4 font-semibold text-tp-on-surface-variant hover:text-tp-primary hover:underline underline-offset-4 transition-all"
            href="./politica_privacidad"
            >Aviso legal y privacidad</a
          >
        </div>
      </div>
      <div class="bg-tp-surface-container-lowest py-4 border-t border-tp-outline-variant/10">
        <p class="text-center text-[12px] leading-4 font-semibold text-pretty text-tp-on-surface-variant opacity-50">
          © 2024 Taxi Peralta. Todos los derechos reservados.
          <br class="sm:hidden" />
          Desarrollado por{" "}
          <a class="hover:text-tp-primary" href="https://burdas.github.io" target="_blank"
            >Burdas</a
          >.
        </p>
      </div>
    </footer>
  )
}
