---
export const prerender = false;
import TarifaCard from "./TarifaCard.astro";
import { formatDate } from "@/utils/Format";

import { getTarifas } from "@/services/externalApi";

const tarifas = await getTarifas();
---

<section
  id="Tarifas"
  class="py-section-gap bg-tp-surface-container-lowest scroll-mt-24"
>
  <div class="max-w-[1200px] mx-auto px-container-padding">
    <div class="text-center mb-16 reveal">
      <span
        class="text-[12px] leading-4 font-semibold tracking-[0.3em] uppercase text-tp-primary"
        >Precios Oficiales</span
      >
      <h2
        class="font-tp-display text-[32px] leading-10 font-bold text-tp-on-surface mt-4"
      >
        Tarifas Gobierno de Navarra
      </h2>
      <div class="w-20 h-1 bg-tp-primary mx-auto mt-6"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="reveal">
        <TarifaCard tipo="diurna" tarifas={tarifas.diurna} />
      </div>
      <div class="reveal reveal-delay-1">
        <TarifaCard tipo="nocturna" tarifas={tarifas.nocturna} />
      </div>
    </div>
    <p
      class="text-center text-tp-on-surface-variant text-[12px] leading-4 font-semibold mt-12 opacity-60"
    >
      * Los precios pueden estar sujetos a variaciones oficiales publicadas por
      el Gobierno de Navarra.
    </p>
    <p
      class="text-center text-tp-on-surface-variant text-[12px] leading-4 font-semibold mt-3 opacity-60"
    >
      Última actualización:{" "}
      {tarifas.date ? formatDate(new Date(tarifas.date)) : "N/A"}
    </p>
  </div>
</section>
