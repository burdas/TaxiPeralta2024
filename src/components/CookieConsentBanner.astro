<div id="cookie-consent-banner" class="fixed bottom-0 left-0 right-0 z-50 glass animate-fade-in" style="display: none;">
    <div class="relative max-w-[1200px] mx-auto px-container-padding py-4">
        <div class="absolute top-0 left-0 right-0 h-[2px] bg-tp-primary"></div>
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex flex-1 items-start gap-3">
                <div class="hidden sm:flex w-10 h-10 rounded-full bg-tp-primary/10 text-tp-primary items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-2xl">cookie</span>
                </div>
                <div>
                    <h3 class="font-tp-display text-lg font-semibold text-tp-on-surface mb-1">
                        Uso de cookies analíticas
                    </h3>
                    <p class="text-sm text-tp-on-surface-variant">
                        Utilizamos cookies analíticas para entender cómo interactúas con nuestro sitio web y mejorar tu experiencia.
                        Estas cookies recopilan información de forma anónima, incluyendo tu dirección IP anonimizada.
                        Puedes aceptar o rechazar estas cookies.
                        <a href="/#PoliticaDePrivacidad" class="text-tp-primary hover:underline">
                            Más información
                        </a>
                    </p>
                </div>
            </div>
            <div class="flex gap-3 shrink-0">
                <button
                    id="cookie-reject-btn"
                    class="px-8 py-3 text-[12px] leading-4 font-bold uppercase tracking-widest border border-tp-on-surface/20 hover:border-tp-primary text-tp-on-surface hover:text-tp-primary rounded-full transition-all"
                >
                    Rechazar
                </button>
                <button
                    id="cookie-accept-btn"
                    class="px-8 py-3 text-[12px] leading-4 font-bold uppercase tracking-widest bg-tp-primary text-tp-on-primary hover:brightness-110 rounded-full transition-all primary-glow"
                >
                    Aceptar
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    const CONSENT_COOKIE_NAME = 'analytics_consent';
    const CONSENT_COOKIE_DAYS = 365;

    function setAnalyticsConsent(consent: boolean) {
        if (typeof document === 'undefined') return;
        
        const expires = new Date();
        expires.setDate(expires.getDate() + CONSENT_COOKIE_DAYS);
        
        document.cookie = `${CONSENT_COOKIE_NAME}=${consent}; expires=${expires.toUTCString()}; path=/`;
    }

    function hasAnalyticsConsent() {
        if (typeof document === 'undefined') return false;
        
        const cookies = document.cookie.split(';');
        const consentCookie = cookies.find(c => c.trim().startsWith(`${CONSENT_COOKIE_NAME}=`));
        
        return consentCookie?.split('=')[1] === 'true';
    }

    // Check if consent is already set
    if (!hasAnalyticsConsent()) {
        const banner = document.getElementById('cookie-consent-banner');
        if (banner) {
            banner.style.display = 'block';
        }
    }

    // Handle accept button
    const acceptBtn = document.getElementById('cookie-accept-btn');
    if (acceptBtn) {
        acceptBtn.addEventListener('click', () => {
            setAnalyticsConsent(true);
            const banner = document.getElementById('cookie-consent-banner');
            if (banner) {
                banner.style.display = 'none';
            }
        });
    }

    // Handle reject button
    const rejectBtn = document.getElementById('cookie-reject-btn');
    if (rejectBtn) {
        rejectBtn.addEventListener('click', () => {
            setAnalyticsConsent(false);
            const banner = document.getElementById('cookie-consent-banner');
            if (banner) {
                banner.style.display = 'none';
            }
        });
    }
</script>
