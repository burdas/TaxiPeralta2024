---
---

<form
  id="contactForm"
  name="contactForm"
  class="space-y-6"
>
  <div class="space-y-2">
    <label
      for="ContactFormNombre"
      class="text-[12px] leading-4 font-semibold uppercase tracking-wider text-tp-on-surface-variant ml-1"
      >Nombre Completo</label
    >
    <input
      required
      type="text"
      name="nombre"
      id="ContactFormNombre"
      placeholder="Su nombre aquí"
      class="w-full bg-tp-surface-container-high border-none focus:ring-2 focus:ring-tp-primary rounded-lg px-4 py-3 text-tp-on-surface placeholder:text-tp-on-surface-variant/40"
    />
  </div>
  <div class="space-y-2">
    <label
      for="ContactFormContacto"
      class="text-[12px] leading-4 font-semibold uppercase tracking-wider text-tp-on-surface-variant ml-1"
      >Teléfono o Email</label
    >
    <input
      type="text"
      name="contacto"
      id="ContactFormContacto"
      placeholder="Forma de contacto"
      class="w-full bg-tp-surface-container-high border-none focus:ring-2 focus:ring-tp-primary rounded-lg px-4 py-3 text-tp-on-surface placeholder:text-tp-on-surface-variant/40"
    />
  </div>
  <div class="space-y-2">
    <label
      for="ContactFormMensaje"
      class="text-[12px] leading-4 font-semibold uppercase tracking-wider text-tp-on-surface-variant ml-1"
      >Mensaje o Detalles del Viaje</label
    >
    <textarea
      required
      name="mensaje"
      id="ContactFormMensaje"
      rows="4"
      placeholder="¿Cómo podemos ayudarle?"
      class="w-full bg-tp-surface-container-high border-none focus:ring-2 focus:ring-tp-primary rounded-lg px-4 py-3 text-tp-on-surface placeholder:text-tp-on-surface-variant/40 resize-none"
    ></textarea>
  </div>
  <p class="text-sm text-tp-on-surface-variant">
    Al enviar el formulario aceptas la
    <a
      href="./politica_privacidad"
      class="text-tp-primary hover:border-b-[1px] border-b-tp-primary"
      >política de privacidad</a
    >.
  </p>
  <button
    type="submit"
    class="w-full bg-tp-primary text-tp-on-primary py-4 rounded-lg font-bold uppercase tracking-widest hover:brightness-110 active:scale-[0.98] transition-all primary-glow"
  >
    Enviar Solicitud
  </button>
  <p
    class="text-[10px] text-center text-tp-on-surface-variant/50 uppercase tracking-tighter"
  >
    Responderemos en menos de 15 minutos
  </p>
</form>
<style>
  input:-webkit-autofill,
  input:-webkit-autofill:hover,
  input:-webkit-autofill:focus,
  input:-webkit-autofill:active {
    -webkit-text-fill-color: black !important;
    -webkit-box-shadow: 0 0 0px 1000px white inset !important;
  }

  html.dark input:-webkit-autofill,
  html.dark input:-webkit-autofill:hover,
  html.dark input:-webkit-autofill:focus,
  html.dark input:-webkit-autofill:active {
    -webkit-text-fill-color: white !important;
    -webkit-box-shadow: 0 0 0px 1000px black inset !important;
  }
</style>
<script>
  import { showDangerToast, showOkToast } from "../utils/Toast";

  const FORM_URL = "https://formspree.io/f/xjkbkrwd";
  const form = document.getElementById("contactForm") as HTMLFormElement;
  form!.addEventListener("submit", (event) => {
    event.preventDefault();
    const formData = new FormData(form);
    const formDataObject = Object.fromEntries(formData.entries());
    fetch(FORM_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(formDataObject),
    })
      .then((response) => {
        if (response.ok) {
          showOkToast("Se ha enviado correctamente");
          form.reset();
        } else showDangerToast("Se ha producido un error");
      })
      .catch((error) => {
        showDangerToast("Se ha producido un error");
        console.error("Error:", error);
      });
  });
</script>
