---
import ContactForm from "./ContactForm.astro";

const GOOGLE_MAPS_STATIC_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_STATIC_API as string;
const STATIC_MAP_BASE = `https://maps.googleapis.com/maps/api/staticmap?center=42.3389757,-1.7990957&zoom=13&scale=2&size=600x300&maptype=roadmap&format=jpg&markers=color:red%7C42.3389757,-1.7990957`;
const STATIC_MAP_DARK_STYLES =
  "&style=feature:all%7Celement:geometry.fill%7Ccolor:0x242f3e" +
  "&style=feature:all%7Celement:labels.text.fill%7Ccolor:0x8a93a6" +
  "&style=feature:all%7Celement:labels.text.stroke%7Ccolor:0x242f3e" +
  "&style=feature:administrative%7Celement:geometry%7Ccolor:0x373e4b" +
  "&style=feature:landscape%7Celement:geometry.fill%7Ccolor:0x242f3e" +
  "&style=feature:poi%7Celement:geometry.fill%7Ccolor:0x2f3a4d" +
  "&style=feature:poi%7Celement:labels.text.fill%7Ccolor:0x8a93a6" +
  "&style=feature:poi%7Celement:labels.text.stroke%7Ccolor:0x242f3e" +
  "&style=feature:road%7Celement:geometry.fill%7Ccolor:0x38414e" +
  "&style=feature:road%7Celement:geometry.stroke%7Ccolor:0x242f3e" +
  "&style=feature:road%7Celement:labels.text.fill%7Ccolor:0xd7dde5" +
  "&style=feature:road%7Celement:labels.text.stroke%7Ccolor:0x38414e" +
  "&style=feature:transit%7Celement:geometry.fill%7Ccolor:0x2f3548" +
  "&style=feature:water%7Celement:geometry.fill%7Ccolor:0x284048" +
  "&style=feature:water%7Celement:labels.text.fill%7Ccolor:0x8a93a6";
const STATIC_MAP_URL_LIGHT = `${STATIC_MAP_BASE}&key=${GOOGLE_MAPS_STATIC_KEY}`;
const STATIC_MAP_URL_DARK = `${STATIC_MAP_BASE}${STATIC_MAP_DARK_STYLES}&key=${GOOGLE_MAPS_STATIC_KEY}`;
---

<section
  id="Contacto"
  class="py-section-gap px-container-padding max-w-[1200px] mx-auto scroll-mt-24"
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
    <div class="reveal reveal-left">
      <h2
        class="font-tp-display text-[32px] leading-10 font-bold text-tp-on-surface mb-8"
      >
        Contacta con nosotros
      </h2>
        <div class="space-y-8">
        <div class="flex items-start gap-4">
          <div
            class="w-12 h-12 rounded-lg bg-tp-surface-container flex items-center justify-center text-tp-primary shrink-0"
          >
            <span class="material-symbols-outlined">call</span>
          </div>
          <div>
            <p
              class="text-[12px] leading-4 font-semibold text-tp-on-surface-variant"
            >
              Teléfono Principal
            </p>
            <p class="text-2xl font-bold text-tp-on-surface">
              <a class="hover:text-tp-primary transition-colors" href="tel:619461076"
                >+34 619 46 10 76</a
              >
            </p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div
            class="w-12 h-12 rounded-lg bg-tp-surface-container flex items-center justify-center text-tp-primary shrink-0"
          >
            <span class="material-symbols-outlined">mail</span>
          </div>
          <div>
            <p
              class="text-[12px] leading-4 font-semibold text-tp-on-surface-variant"
            >
              Email
            </p>
            <p class="text-xl font-semibold text-tp-on-surface">
              <a
                class="hover:text-tp-primary transition-colors"
                href="mailto:taxi1peralta@gmail.com"
                >taxi1peralta@gmail.com</a
              >
            </p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div
            class="w-12 h-12 rounded-lg bg-tp-surface-container flex items-center justify-center text-tp-primary shrink-0"
          >
            <span class="material-symbols-outlined">location_on</span>
          </div>
          <div>
            <p
              class="text-[12px] leading-4 font-semibold text-tp-on-surface-variant"
            >
              Ubicación Base
            </p>
            <p class="text-lg text-tp-on-surface">Peralta, Navarra</p>
          </div>
        </div>
      </div>
      <div
        class="mt-12 h-64 w-full rounded-xl overflow-hidden border border-tp-outline-variant"
      >
        <img
          id="staticMap"
          alt="Mapa de Peralta"
          class="w-full h-full object-cover"
          src={STATIC_MAP_URL_LIGHT}
          data-light-src={STATIC_MAP_URL_LIGHT}
          data-dark-src={STATIC_MAP_URL_DARK}
        />
      </div>
    </div>
    <div
      class="reveal reveal-right reveal-delay-1 bg-tp-surface-container-low p-8 md:p-12 rounded-xl border border-tp-outline-variant h-full flex flex-col"
    >
      <ContactForm />
    </div>
  </div>
</section>
<script>
  const staticMapImg = document.getElementById("staticMap") as HTMLImageElement;

  const updateStaticMapTheme = () => {
    staticMapImg.src = document.documentElement.classList.contains("dark")
      ? staticMapImg.dataset.darkSrc!
      : staticMapImg.dataset.lightSrc!;
  };

  updateStaticMapTheme();

  new MutationObserver(updateStaticMapTheme).observe(
    document.documentElement,
    { attributes: true, attributeFilter: ["class"] }
  );

  window.addEventListener("storage", updateStaticMapTheme);
</script>
