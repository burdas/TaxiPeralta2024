---
import { numToEur } from "../utils/Format.ts";

interface Props {
  tipo: "diurna" | "nocturna";
  tarifas: Record<string, number>;
}

const { tipo, tarifas } = Astro.props;

const config = {
  diurna: {
    titulo: "Tarifa Diurna",
    subtitulo: "Lunes a Viernes (07:00 - 22:00)",
    icono: "wb_sunny",
  },
  nocturna: {
    titulo: "Nocturna / Festivos",
    subtitulo: "Noches, Sábados, Domingos y Festivos",
    icono: "dark_mode",
  },
};

const rows = [
  { label: "Kilómetro Recorrido", key: "kmRecorrido" },
  { label: "Hora de Espera", key: "horaEspera" },
  { label: "Servicio Mínimo", key: "minimoPercepcion" },
];
---

<article class="card-lift glass p-10 rounded-xl relative overflow-hidden">
  <div class="flex justify-between items-start mb-8">
    <div>
      <h4
        class="font-tp-display text-[20px] leading-7 font-semibold text-tp-on-surface"
      >
        {config[tipo].titulo}
      </h4>
      <p
        class="text-tp-on-surface-variant text-[12px] leading-4 font-semibold tracking-[0.05em]"
      >
        {config[tipo].subtitulo}
      </p>
    </div>
    <span class="material-symbols-outlined text-tp-primary text-4xl">
      {config[tipo].icono}
    </span>
  </div>
  <div class="space-y-6">
    {
      rows.map((r) => (
        <div
          class="flex justify-between items-center border-b border-tp-outline-variant pb-4 last:border-b-0"
        >
          <span class="text-tp-on-surface-variant">{r.label}</span>
          <span
            class="font-tp-display text-[20px] leading-7 font-semibold text-tp-on-surface"
          >
            {numToEur(tarifas[r.key] ?? 0)}
          </span>
        </div>
      ))
    }
  </div>
</article>
