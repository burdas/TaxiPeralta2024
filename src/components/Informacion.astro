---
import InfoCard from "./InfoCard.astro";
import { informacion } from "../model/informacion.ts";
---

<section
  id="Informacion"
  class="py-section-gap px-container-padding max-w-[1200px] mx-auto scroll-mt-24"
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
    <InfoCard
      title="Información Estándar"
      informacion={informacion.estandar}
    />
    <article
      class="reveal reveal-right reveal-delay-1 card-lift bg-tp-primary text-tp-on-primary rounded-xl p-10 flex flex-col gap-6 relative overflow-hidden group"
    >
      <div class="absolute -right-10 -top-10 opacity-10 transition-transform group-hover:scale-110 pointer-events-none">
        <span class="material-symbols-outlined text-[200px]"
          style="font-variation-settings: 'FILL' 1"
          >stars</span
        >
      </div>
      <div class="flex items-center gap-4">
        <span
          class="material-symbols-outlined text-tp-on-primary text-4xl"
          style="font-variation-settings: 'FILL' 1"
          >diamond</span
        >
        <h3 class="font-tp-display text-[32px] leading-10 font-bold">
          Servicios VIP
        </h3>
      </div>
      <p class="opacity-90">
        Un vehículo de alta gama equipado con todo lo necesario para que su
        viaje sea una experiencia de máximo confort.
      </p>
      <div class="grid grid-cols-2 gap-4">
        {
          informacion.vip.map(({ titulo, subtitulo }) => (
            <div class="flex flex-col gap-1">
              <span class="font-bold text-lg">{titulo}</span>
              <span class="text-xs uppercase tracking-tighter opacity-70">
                {subtitulo}
              </span>
            </div>
          ))
        }
      </div>
    </article>
  </div>
</section>
