---
const { informacion, title } = Astro.props;
---

<article
  class="bg-tp-surface-container-low border border-tp-outline-variant rounded-xl p-10 flex flex-col gap-6"
>
  <div class="flex items-center gap-4">
    <span class="material-symbols-outlined text-tp-primary text-4xl"
      >commute</span
    >
    <h3 class="font-tp-display text-[32px] leading-10 font-bold text-tp-on-surface">
      {title}
    </h3>
  </div>
  <p class="text-tp-on-surface-variant">
    Ofrecemos soluciones de transporte versátiles adaptadas a las necesidades
    diarias de instituciones y particulares.
  </p>
  <ul class="space-y-4">
    {
      informacion.map((i: string) => (
        <li class="flex items-center gap-3">
          <span class="material-symbols-outlined text-tp-primary text-xl"
            >check_circle</span
          >
          <span class="text-tp-on-surface">{i}</span>
        </li>
      ))
    }
  </ul>
</article>
