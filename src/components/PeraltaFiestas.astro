---
import { Image } from "astro:assets";
import imgFiestas from "../assets/fiestas_peralta.avif";
---
<script type="text/javascript" is:inline>
  // Only dark mode
  if (!document.documentElement.classList.contains("dark")) document.documentElement.classList.add("dark");
</script>
<Image
  src={imgFiestas}
  alt="Imagen de fiestas"
  class="w-full h-full object-cover object-center absolute inset-0 -z-50 opacity-60"
/>
<main
  id="FiestasDePeralta"
  class="w-full h-[calc(100dvh-144px)] flex flex-col justify-center items-center gap-6 md:gap-10 px-6"
>
  <div class="text-center animate-hero-fade-up">
    <h1 class="font-tp-display text-6xl md:text-8xl leading-tight tracking-tight font-bold text-white">
      Fiestas de Peralta
    </h1>
  </div>
  <div id="countdownContainer" class="hidden w-full max-w-sm md:max-w-none flex-col md:flex-row items-stretch md:items-center justify-center gap-3 md:gap-4">
    <div class="glass rounded-2xl px-5 md:px-8 py-4 md:py-6 w-full md:w-auto md:min-w-[108px] flex flex-row md:flex-col items-center justify-between md:justify-center gap-2 md:gap-0">
      <span id="days" class="font-tp-display text-5xl md:text-7xl font-bold text-tp-primary tabular-nums">00</span>
      <p class="text-[11px] md:text-[11px] leading-4 font-semibold uppercase tracking-widest text-tp-on-surface-variant md:mt-2">Días</p>
    </div>
    <div class="glass rounded-2xl px-5 md:px-8 py-4 md:py-6 w-full md:w-auto md:min-w-[108px] flex flex-row md:flex-col items-center justify-between md:justify-center gap-2 md:gap-0">
      <span id="hours" class="font-tp-display text-5xl md:text-7xl font-bold text-tp-primary tabular-nums">00</span>
      <p class="text-[11px] md:text-[11px] leading-4 font-semibold uppercase tracking-widest text-tp-on-surface-variant md:mt-2">Horas</p>
    </div>
    <div class="glass rounded-2xl px-5 md:px-8 py-4 md:py-6 w-full md:w-auto md:min-w-[108px] flex flex-row md:flex-col items-center justify-between md:justify-center gap-2 md:gap-0">
      <span id="minutes" class="font-tp-display text-5xl md:text-7xl font-bold text-tp-primary tabular-nums">00</span>
      <p class="text-[11px] md:text-[11px] leading-4 font-semibold uppercase tracking-widest text-tp-on-surface-variant md:mt-2">Minutos</p>
    </div>
    <div class="glass rounded-2xl px-5 md:px-8 py-4 md:py-6 w-full md:w-auto md:min-w-[108px] flex flex-row md:flex-col items-center justify-between md:justify-center gap-2 md:gap-0">
      <span id="seconds" class="font-tp-display text-5xl md:text-7xl font-bold text-tp-primary tabular-nums">00</span>
      <p class="text-[11px] md:text-[11px] leading-4 font-semibold uppercase tracking-widest text-tp-on-surface-variant md:mt-2">Segundos</p>
    </div>
  </div>
</main>
<script>
  const countDownContainer = document.getElementById("countdownContainer");
  const days = document.getElementById("days");
  const hours = document.getElementById("hours");
  const minutes = document.getElementById("minutes");
  const seconds = document.getElementById("seconds");

  function getChupinazoDate(year: number): Date {
    const firstOfSeptember = new Date(year, 8, 1);
    const daysToFirstSunday = (7 - firstOfSeptember.getDay()) % 7;
    const firstSunday = new Date(year, 8, 1 + daysToFirstSunday);
    const chupinazo = new Date(firstSunday);
    chupinazo.setDate(chupinazo.getDate() - 1);
    chupinazo.setHours(13, 0, 0, 0);
    return chupinazo;
  }

  const now = new Date();
  let chupinazo = getChupinazoDate(now.getFullYear());
  if (chupinazo <= now) chupinazo = getChupinazoDate(now.getFullYear() + 1);

  // TEMPORAL (PRUEBA): adelantar el chupinazo una semana.
  // Quitar este bloque cuando finalice la prueba.
  chupinazo.setDate(chupinazo.getDate() - 7);

  console.info("Chupinazo (fecha objetivo):", chupinazo.toLocaleString());

  setInterval(() => {
    const nowMs = new Date().getTime();
    const distance = chupinazo.getTime() - nowMs;
    const daysLeft = Math.max(0, Math.floor(distance / (1000 * 60 * 60 * 24)));
    const hoursLeft = Math.max(0, Math.floor(   (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)));
    const minutesLeft = Math.max(0, Math.floor((   (distance % (1000 * 60 * 60)) / (1000 * 60))));
    const secondsLeft = Math.max(0, Math.floor((   (distance % (1000 * 60)) / 1000)));
    
    days!.innerHTML = daysLeft.toString().padStart(2, "0");
    hours!.innerHTML = hoursLeft.toString().padStart(2, "0");
    minutes!.innerHTML = minutesLeft.toString().padStart(2, "0");
    seconds!.innerHTML = secondsLeft.toString().padStart(2, "0");
    if (countDownContainer!.classList.contains("hidden")) {
        countDownContainer!.classList.remove("hidden");
        countDownContainer!.classList.add("flex");
    }
  }, 1000);
</script>