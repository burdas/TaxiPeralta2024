---
import { Image } from "astro:assets";
import imgFiestas from "../assets/fiestas_peralta.avif";
---
<script type="text/javascript" is:inline>
  // Only dark mode
  if (!document.documentElement.classList.contains("dark")) document.documentElement.classList.add("dark");
</script>
<Image
  src={imgFiestas}
  alt="Imagen de fiestas"
  class="w-full h-full object-cover object-center absolute inset-0 -z-50 opacity-60"
/>
<main
  id="FiestasDePeralta"
  class="w-full h-[calc(100dvh-144px)] flex flex-col justify-center items-center gap-6 md:gap-10 px-6"
>
  <div class="text-center animate-hero-fade-up" data-hero-animate>
    <h1 class="font-tp-display text-6xl md:text-8xl leading-tight tracking-tight font-bold text-white">
      Fiestas de Peralta
    </h1>
  </div>
  <div id="countdownContainer" class="flex w-full max-w-sm md:max-w-none flex-col md:flex-row items-stretch md:items-center justify-center gap-3 md:gap-4">
    <div class="glass rounded-2xl px-5 md:px-8 py-4 md:py-6 w-full md:w-auto md:min-w-[108px] flex flex-row md:flex-col items-center justify-between md:justify-center gap-2 md:gap-0 animate-hero-fade-up data-hero-animate [animation-delay:0.45s]">
      <span id="days" class="font-tp-display text-5xl md:text-7xl font-bold text-tp-primary tabular-nums">00</span>
      <p class="text-[11px] md:text-[11px] leading-4 font-semibold uppercase tracking-widest text-tp-on-surface-variant md:mt-2">Días</p>
    </div>
    <div class="glass rounded-2xl px-5 md:px-8 py-4 md:py-6 w-full md:w-auto md:min-w-[108px] flex flex-row md:flex-col items-center justify-between md:justify-center gap-2 md:gap-0 animate-hero-fade-up data-hero-animate [animation-delay:0.6s]">
      <span id="hours" class="font-tp-display text-5xl md:text-7xl font-bold text-tp-primary tabular-nums">00</span>
      <p class="text-[11px] md:text-[11px] leading-4 font-semibold uppercase tracking-widest text-tp-on-surface-variant md:mt-2">Horas</p>
    </div>
    <div class="glass rounded-2xl px-5 md:px-8 py-4 md:py-6 w-full md:w-auto md:min-w-[108px] flex flex-row md:flex-col items-center justify-between md:justify-center gap-2 md:gap-0 animate-hero-fade-up data-hero-animate [animation-delay:0.75s]">
      <span id="minutes" class="font-tp-display text-5xl md:text-7xl font-bold text-tp-primary tabular-nums">00</span>
      <p class="text-[11px] md:text-[11px] leading-4 font-semibold uppercase tracking-widest text-tp-on-surface-variant md:mt-2">Minutos</p>
    </div>
    <div class="glass rounded-2xl px-5 md:px-8 py-4 md:py-6 w-full md:w-auto md:min-w-[108px] flex flex-row md:flex-col items-center justify-between md:justify-center gap-2 md:gap-0 animate-hero-fade-up data-hero-animate [animation-delay:0.9s]">
      <span id="seconds" class="font-tp-display text-5xl md:text-7xl font-bold text-tp-primary tabular-nums">00</span>
      <p class="text-[11px] md:text-[11px] leading-4 font-semibold uppercase tracking-widest text-tp-on-surface-variant md:mt-2">Segundos</p>
    </div>
  </div>
</main>
<script>
  const days = document.getElementById("days");
  const hours = document.getElementById("hours");
  const minutes = document.getElementById("minutes");
  const seconds = document.getElementById("seconds");

  function getChupinazoDate(year: number): Date {
    const firstOfSeptember = new Date(year, 8, 1);
    const daysToFirstSunday = (7 - firstOfSeptember.getDay()) % 7;
    const firstSunday = new Date(year, 8, 1 + daysToFirstSunday);
    const chupinazo = new Date(firstSunday);
    chupinazo.setDate(chupinazo.getDate() - 1);
    chupinazo.setHours(13, 0, 0, 0);
    return chupinazo;
  }

  const now = new Date();
  let chupinazo = getChupinazoDate(now.getFullYear());
  if (chupinazo <= now) chupinazo = getChupinazoDate(now.getFullYear() + 1);

  // TEMPORAL (PRUEBA): adelantar el chupinazo una semana.
  // Quitar este bloque cuando finalice la prueba.
  chupinazo.setDate(chupinazo.getDate() - 7);

  console.info("Chupinazo (fecha objetivo):", chupinazo.toLocaleString());

  function getRemaining() {
    const distance = chupinazo.getTime() - Date.now();
    return {
      days: Math.max(0, Math.floor(distance / (1000 * 60 * 60 * 24))),
      hours: Math.max(0, Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))),
      minutes: Math.max(0, Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60))),
      seconds: Math.max(0, Math.floor((distance % (1000 * 60)) / 1000)),
    };
  }

  function render(remaining: { days: number; hours: number; minutes: number; seconds: number }) {
    days!.innerHTML = remaining.days.toString().padStart(2, "0");
    hours!.innerHTML = remaining.hours.toString().padStart(2, "0");
    minutes!.innerHTML = remaining.minutes.toString().padStart(2, "0");
    seconds!.innerHTML = remaining.seconds.toString().padStart(2, "0");
  }

  function animateCountUp(onDone: () => void) {
    const target = getRemaining();
    const duration = 1300;
    const start = performance.now();
    const frame = (now: number) => {
      const progress = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - progress, 3);
      render({
        days: Math.floor(target.days * eased),
        hours: Math.floor(target.hours * eased),
        minutes: Math.floor(target.minutes * eased),
        seconds: Math.floor(target.seconds * eased),
      });
      if (progress < 1) requestAnimationFrame(frame);
      else onDone();
    };
    requestAnimationFrame(frame);
  }

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (prefersReducedMotion) {
    render(getRemaining());
    setInterval(() => render(getRemaining()), 1000);
  } else {
    setTimeout(() => {
      animateCountUp(() => {
        setInterval(() => render(getRemaining()), 1000);
      });
    }, 550);
  }
</script>