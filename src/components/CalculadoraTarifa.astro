---
import AnimateBadge from "./AnimateBadge.astro";
---
<p class="text-center text-base text-neutral-700/70 dark:text-neutral-200/80 mt-16">El precio siguiente es <u>orientativo</u>, no se tienen en cuenta otros costes.</p>

<form class="flex flex-wrap justify-center items-center gap-2 mt-8">
  {[
    { id: "inputKmRecorridoDiurno", label: "Km Recorrido (Diurno)" },
    { id: "inputHoraEsperaDiurno", label: "Hora de espera (Diurno)" },
    { id: "inputKmRecorridoNocturno", label: "Km Recorrido (Nocturno)" },
    { id: "inputHoraEsperaNocturno", label: "Hora de espera (Nocturno)" }
  ].map((item, index) => (
    <>
      <div class="flex flex-col items-center gap-1">
        <button type="button" class="btn-increment text-neutral-400 hover:text-white font-bold">+</button>
        <input
          id={item.id}
          type="number"
          class="w-15 text-center outline-none bg-transparent text-gray-900 dark:text-white text-lg font-semibold"
          placeholder="0"
        />
        <button type="button" class="btn-decrement text-neutral-400 hover:text-white font-bold">-</button>
        <span class="text-xs text-neutral-500 text-center w-25">{item.label}</span>
      </div>
      {index < 3 && <div class="flex items-center justify-center -mt-5"><span class="text-2xl font-light text-neutral-400">+</span></div>}
    </>
  ))}
</form>

<div class="flex justify-center items-center gap-4 mt-8 text-2xl font-bold">
  <span>Total:</span>
  <input
    id="inputTotalTarifas"
    type="text"
    disabled
    class="w-37.5 text-center outline-none bg-transparent border-b-2 border-blue-500 text-gray-900 dark:text-white text-2xl p-2"
    value="0,00 €"
  />
</div>

<style>
  input::-webkit-outer-spin-button,
  input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  input[type="number"] {
    -moz-appearance: textfield;
  }
</style>
<script>
  import { numToEur } from "../utils/Format";

  let currentTarifas: any = null;

  const fetchTarifas = async () => {
    try {
      const response = await fetch("/api/tarifas");
      if (response.ok) {
        currentTarifas = await response.json();
        changeTotalTarifas();
      }
    } catch (error) {
      console.error("Error fetching tariffs:", error);
    }
  };

  const changeTotalTarifas = () => {
    if (!currentTarifas) return;

    const inputKmDiurno = document.getElementById("inputKmRecorridoDiurno") as HTMLInputElement;
    const inputHoraDiurno = document.getElementById("inputHoraEsperaDiurno") as HTMLInputElement;
    const inputKmNocturno = document.getElementById("inputKmRecorridoNocturno") as HTMLInputElement;
    const inputHoraNocturno = document.getElementById("inputHoraEsperaNocturno") as HTMLInputElement;
    const inputTotal = document.getElementById("inputTotalTarifas") as HTMLInputElement;

    if (!inputKmDiurno || !inputHoraDiurno || !inputKmNocturno || !inputHoraNocturno || !inputTotal) return;

    const kmDiurno = Number(inputKmDiurno.value || 0);
    const horaDiurno = Number(inputHoraDiurno.value || 0);
    const kmNocturno = Number(inputKmNocturno.value || 0);
    const horaNocturno = Number(inputHoraNocturno.value || 0);

    let totalDiurno = kmDiurno * (currentTarifas.diurna?.kmRecorrido || 0) + 
                       horaDiurno * (currentTarifas.diurna?.horaEspera || 0);
    
    if (totalDiurno > 0 && totalDiurno < (currentTarifas.diurna?.minimoPercepcion || 0)) {
        totalDiurno = currentTarifas.diurna.minimoPercepcion;
    }

    let totalNocturno = kmNocturno * (currentTarifas.nocturna?.kmRecorrido || 0) + 
                         horaNocturno * (currentTarifas.nocturna?.horaEspera || 0);

    if (totalNocturno > 0 && totalNocturno < (currentTarifas.nocturna?.minimoPercepcion || 0)) {
        totalNocturno = currentTarifas.nocturna.minimoPercepcion;
    }

    const total = totalDiurno + totalNocturno;
    inputTotal.value = numToEur(total);
  };

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    if (target.classList.contains("btn-increment") || target.classList.contains("btn-decrement")) {
      const container = target.closest(".flex-col");
      const input = container?.querySelector("input") as HTMLInputElement;
      if (input) {
        let value = Number(input.value) || 0;
        if (target.classList.contains("btn-increment")) {
          value++;
        } else {
          value = Math.max(0, value - 1);
        }
        input.value = value.toString();
        changeTotalTarifas();
      }
    }
  });

  document.addEventListener("input", (event) => {
    const target = event.target as HTMLInputElement;
    if (target && target.id && target.id.startsWith("input") && target.id !== "inputTotalTarifas") {
      changeTotalTarifas();
    }
  });

  fetchTarifas();
</script>
