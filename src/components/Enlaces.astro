---
export const prerender = false;

import { getEnlacesInteres, type IEnlace } from "@/services/externalApi";

const enlaces = await getEnlacesInteres();
---

<section id="Enlaces" class="py-12 border-y border-tp-outline-variant/30 scroll-mt-24">
  <div class="max-w-[1200px] mx-auto px-container-padding">
    <h5
      class="text-[12px] leading-4 font-semibold text-tp-on-surface-variant text-center uppercase tracking-widest mb-8"
    >
      Enlaces de Interés
    </h5>
    <div class="flex flex-wrap justify-center gap-4">
      {
        enlaces.map((e: IEnlace) => (
          <a
            class="px-6 py-2 rounded-full border border-tp-outline-variant hover:border-tp-primary hover:text-tp-primary transition-all text-[12px] leading-4 font-semibold text-tp-on-surface-variant"
            href={e.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {e.texto}
          </a>
        ))
      }
    </div>
  </div>
</section>
