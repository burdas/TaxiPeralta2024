---
export const prerender = true;
---

<section
  id="Tarifas"
  class="py-section-gap bg-tp-surface-container-lowest scroll-mt-24"
>
  <div class="max-w-[1200px] mx-auto px-container-padding">
    <div class="text-center mb-16">
      <span
        class="text-[12px] leading-4 font-semibold tracking-[0.3em] uppercase text-tp-primary"
        >Precios Oficiales</span
      >
      <h2
        class="font-tp-display text-[32px] leading-10 font-bold text-tp-on-surface mt-4"
      >
        Tarifas Gobierno de Navarra
      </h2>
      <div class="w-20 h-1 bg-tp-primary mx-auto mt-6"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        [1, 2].map(() => (
          <div
            class="glass p-10 rounded-xl animate-pulse2 h-[280px]"
          ></div>
        ))
      }
    </div>
  </div>
</section>
